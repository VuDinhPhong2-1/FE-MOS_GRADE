{
	"name": "mos-grader-pro",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite",
		"dev:lan": "vite --host 0.0.0.0",
		"dev:be-local": "vite --mode be-local",
		"dev:be-local:lan": "vite --mode be-local --host 0.0.0.0",
		"dev:be-deploy": "vite --mode be-deploy",
		"dev:be-deploy:lan": "vite --mode be-deploy --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"build:be-local": "tsc -b && vite build --mode be-local",
		"build:be-deploy": "tsc -b && vite build --mode be-deploy",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"ci": "biome ci .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@bug-on/m3-expressive": "^1.3.6",
		"@bug-on/m3-tailwind": "^1.2.3",
		"@bug-on/m3-tokens": "^1.2.2",
		"@react-oauth/google": "^0.13.4",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.102.8",
		"axios": "^1.13.2",
		"clsx": "^2.1.1",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.0.0",
		"jwt-decode": "^4.0.0",
		"motion": "^13.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-export-table-to-excel": "^1.0.6",
		"react-router-dom": "^7.11.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"xlsx-js-style": "^1.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"typescript": "~5.9.3",
		"vite": "^7.2.4"
	}
}
